{
  "name": "poster-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP remoto poster-rush: lectura y escritura controlada de las cuentas P\u00f3ster POS de la red RUSH",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "POSTER_LIVE=1 vitest run test/live.read.test.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
